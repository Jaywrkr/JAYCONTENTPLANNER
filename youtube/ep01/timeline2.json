{"lines": [{"sec": 0, "sc": "eq0", "t": "Mañana empiezo.", "a0": 0.0, "b0": 3.75, "a": 0.6, "b": 3.16}, {"sec": 0, "sc": "words", "t": "Lo has dicho. Yo también.", "a0": 5.12, "b0": 8.246, "a": 3.86, "b": 6.99}, {"sec": 0, "sc": "key:nunca", "t": "Y casi nunca empieza.", "a0": 8.246, "b0": 10.33, "a": 6.99, "b": 9.07}, {"sec": 0, "sc": "todos", "t": "Le pasa a todos.", "a0": 11.92, "b0": 13.8, "a": 9.77, "b": 11.65}, {"sec": 0, "sc": "strike:flojera", "t": "no es flojera.", "a0": 14.55, "b0": 18.83, "a": 12.35, "b": 16.51}, {"sec": 0, "sc": "inv", "t": "es algo más simple.", "a0": 20.42, "b0": 24.08, "a": 17.21, "b": 20.87}, {"sec": 1, "sc": "words", "t": "Nadie decide no hacerlo.", "a0": 25.3, "b0": 28.34, "a": 21.57, "b": 24.61}, {"sec": 1, "sc": "key:hoy", "t": "Solo decides no hacerlo hoy.", "a0": 29.16, "b0": 33.02, "a": 25.31, "b": 29.17}, {"sec": 1, "sc": "cal", "t": "el único día que cuenta.", "a0": 34.18, "b0": 45.07, "a": 29.87, "b": 39.37}, {"sec": 1, "sc": "type", "t": "haz la cuenta.", "a0": 45.77, "b0": 46.93, "a": 40.07, "b": 41.23}, {"sec": 1, "sc": "words", "t": "una cosa pendiente cada semana.", "a0": 46.93, "b0": 50.989999999999995, "a": 41.23, "b": 45.29}, {"sec": 1, "sc": "grid52", "t": "En un año son 52.", "a0": 51.74, "b0": 53.25, "a": 45.99, "b": 47.5}, {"sec": 1, "sc": "grid52e", "t": "52 cosas que no pasaron.", "a0": 54.27, "b0": 59.53, "a": 48.2, "b": 53.46}, {"sec": 1, "sc": "strike:fallaste>pospusiste", "t": "no es que fallaste.", "a0": 60.33, "b0": 68.92, "a": 54.16, "b": 62.26}, {"sec": 1, "sc": "words", "t": "cada vez dijiste lo mismo.", "a0": 71.0, "b0": 73.68631578947368, "a": 62.96, "b": 65.65}, {"sec": 1, "sc": "stack", "t": "Mañana.", "a0": 73.68631578947368, "b0": 74.19, "a": 65.65, "b": 66.15}, {"sec": 2, "sc": "strike:un día>una palabra", "t": "mañana es", "a0": 75.0, "b0": 81.34, "a": 66.85, "b": 71.16}, {"sec": 2, "sc": "strike:mañana>hoy", "t": "cuando llega", "a0": 82.23, "b0": 87.25, "a": 71.86, "b": 76.73}, {"sec": 2, "s